# ── Telegram ──────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM=123456789:AA...your-token-here

# Chat id where qualified leads get delivered (your team channel/group).
# Get ids via @userinfobot or /id in a group with the bot.
DESTINATION_CHAT_ID=-1001234567890

# Comma separated chat ids to monitor (optional — can also be added via /addchannel)
SOURCE_CHANNELS=

# Telegram user ids allowed to use admin commands (export/mark/channels)
ADMIN_IDS=123456789

# ── AI provider chain: auto = mistral -> ollama -> regex ──
AI_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Tuning ────────────────────────────────────────────────
# Minimum score (0-100) for a lead to be forwarded to DESTINATION_CHAT_ID
MIN_LEAD_SCORE=50
MIN_TEXT_LEN=25
DB_PATH=data/realstate.db
