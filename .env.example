# ── Telegram ──────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM=123456789:AA...your-token-here

# Chat id where qualified leads get delivered (your team channel/group)
DESTINATION_CHAT_ID=-1001234567890

# Optional: comma-separated group chat ids the bot should also monitor
SOURCE_CHANNELS=

# Telegram user ids allowed to run admin commands (/addsearch, /scrape, /export…)
ADMIN_IDS=123456789

# ── AI provider chain: auto = mistral → ollama → regex ────
AI_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Scraping (Scrapling) ──────────────────────────────────
# auto = fast HTTP fetch, escalates to stealth browser on blocks
SCRAPER_ENGINE=auto
SCRAPE_INTERVAL_MINUTES=30
SCRAPE_MAX_PAGES=2
SCRAPE_ENRICH_DETAILS=false
SCRAPER_DELAY_RANGE=1.5-4.0

# ── Web CRM ───────────────────────────────────────────────
CRM_HOST=0.0.0.0
CRM_PORT=8080
# Leave empty to disable auth (local dev only!)
CRM_PASSWORD=change-me-please
# Public URL so Telegram alerts link back into the CRM
CRM_PUBLIC_URL=

# ── Tuning ────────────────────────────────────────────────
MIN_LEAD_SCORE=50
MIN_TEXT_LEN=25
DB_PATH=data/findii.db
